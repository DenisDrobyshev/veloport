# Скопируйте в .env и заполните
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.ru
# Прод-БД (Postgres). Если не задано — используется SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/veloport

# Оплата ЮKassa. Если пусто — включается demo-режим (имитация оплаты).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
